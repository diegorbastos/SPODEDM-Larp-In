    "backgroundColor": "#080909",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.diegorbastos.larpin",
      "buildNumber": "2"
    },
    "android": {
      "package": "com.diegorbastos.larpin",
      "versionCode": 2
    },
    "web": {
      "name": "Larp-In",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.4"
          }
        }
      ],
      "./plugins/withLarpDeviceControl",
      "expo-font"
    ]
  }
}
